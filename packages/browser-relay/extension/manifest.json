{
	"manifest_version": 3,
	"name": "ZAG Browser Relay",
	"version": "0.1.0",
	"description": "Lets the zag coding agent drive your existing tabs through a local CDP relay.",
	"author": "Stencil Labs, Inc.",
	"homepage_url": "https://github.com/rezgaraam/zag",
	"permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
	"background": {
		"service_worker": "background.js"
	},
	"options_page": "options.html",
	"action": {
		"default_title": "ZAG Browser Relay (click for settings)"
	}
}
